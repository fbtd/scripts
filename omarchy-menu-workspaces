#!/bin/bash
# Workspace switcher popup (Omarchy select menu).
# Each row is "N  Name". Names come from ~/.config/omarchy/workspace-names.json,
# otherwise the Hyprland workspace name, otherwise the last window title.
# The current workspace uses a check icon. Every row gets a subtext of
# "current", "empty", or "N windows". The menu always highlights the first
# row, so the icon is a marker, not a selection.
#
# Usage:
#   omarchy-menu-workspaces           # switch to a workspace
#   omarchy-menu-workspaces --rename  # set a persistent name for a workspace

set -euo pipefail

NAMES_FILE="${OMARCHY_WORKSPACE_NAMES:-$HOME/.config/omarchy/workspace-names.json}"
ICON=$'\U000f035c' # nf-md-view_dashboard_outline
CURRENT_ICON=$'\U000f05e0' # nf-md-check_circle
MODE=switch

case "${1:-}" in
  --rename | rename) MODE=rename ;;
  -h | --help | help)
    cat <<'USAGE'
Usage: omarchy-menu-workspaces [--rename]

Switch workspaces from an Omarchy popup, showing number and name.
Persistent names live in ~/.config/omarchy/workspace-names.json.
USAGE
    exit 0
    ;;
esac

mkdir -p "$(dirname "$NAMES_FILE")"
[[ -f $NAMES_FILE ]] || printf '{}\n' >"$NAMES_FILE"

workspaces_json=$(hyprctl workspaces -j)
active_id=$(jq -r '.id' <<<"$(hyprctl activeworkspace -j)")

rows=$(jq -r --arg icon "$ICON" --arg current_icon "$CURRENT_ICON" --argjson active "$active_id" --slurpfile names_file "$NAMES_FILE" '
  def names: $names_file[0] // {};
  def custom_name($id): names[$id | tostring] // empty;
  def pretty($id; $w):
    custom_name($id)
     // (if ($w.name | tostring) != ($id | tostring) then $w.name else empty end)
     // (if ($w.lastwindowtitle // "") != "" then $w.lastwindowtitle else empty end)
     // "";
  . as $ws
  | ([range(1; 11)] + ($ws | map(.id)) | unique | map(select(. > 0)) | sort) as $ids
  | $ids[]
  | . as $id
  | ($ws | map(select(.id == $id)) | .[0] // {id: $id, name: ($id | tostring), lastwindowtitle: ""}) as $w
  | pretty($id; $w) as $label
  | (if $label == "" then ($id | tostring) else ($id | tostring) + "  " + $label end) as $shown
  | (if $id == $active then $current_icon else $icon end) as $row_icon
  | ($w.windows // 0) as $windows
  | (if $id == $active then "current"
     elif $windows == 0 then "empty"
     elif $windows == 1 then "1 window"
     else ($windows | tostring) + " windows" end) as $mark
  | $row_icon + "\t" + $shown + "\t" + $mark
' <<<"$workspaces_json")

[[ -n $rows ]] || exit 1

prompt="Switch workspace"
[[ $MODE == rename ]] && prompt="Name workspace"

selection=$(omarchy-menu-select "$prompt" <<<"$rows" -- --width 520 ) || exit 0
[[ -n $selection ]] || exit 0

label=$(cut -f1 <<<"$selection")
id=${label%% *}
[[ $id =~ ^[0-9]+$ ]] || exit 1

if [[ $MODE == switch ]]; then
  hyprctl dispatch "hl.dsp.focus({ workspace = \"$id\" })" >/dev/null
  exit 0
fi

current=$(jq -r --arg id "$id" '.[$id] // empty' "$NAMES_FILE")
name=$(omarchy-menu-input "Name for workspace $id" --width 420) || exit 0
name=$(printf '%s' "$name" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')

tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT

if [[ -z $name ]]; then
  jq --arg id "$id" 'del(.[$id])' "$NAMES_FILE" >"$tmp"
else
  jq --arg id "$id" --arg name "$name" '. + {($id): $name}' "$NAMES_FILE" >"$tmp"
fi
mv "$tmp" "$NAMES_FILE"
trap - EXIT

if [[ -n $name ]]; then
  omarchy-notification-send -g "$ICON" "Workspace $id" "Named “$name”"
else
  omarchy-notification-send -g "$ICON" "Workspace $id" "Cleared custom name${current:+ (was “$current”)}"
fi
